{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "printWidth": 100,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "coverage/",
    "*.log",
    ".env",
    ".env.*",
    "sessions/",
    "api_sessions/",
    "workspace/",
    "package-lock.json",
    "**/*.generated.ts",
    ".agents/",
    ".claude/",
    ".archon/",
    "packages/docs-web/",
    ".github/",
    "docs/",
    "CLAUDE.md",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "*.yml",
    "*.yaml",
    "packages/isolation/docker/playwright-seccomp.json",
    "packages/isolation/docker/playwright-seccomp.no-io-uring.chroot.json",
    ".omx/",
    "runtime/.omx/",
    ".omx/**",
    "runtime/.omx/**"
  ]
}
