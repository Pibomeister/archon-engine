{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "node_modules/**",
    "packages/*/node_modules/**",
    "packages/*/dist/**",
    "dist/**",
    "coverage/**",
    ".agents/examples/**",
    "packages/docs-web/**",
    "workspace/**",
    "worktrees/**",
    ".claude/worktrees/**",
    ".claude/skills/**",
    ".archon/**",
    ".omx/**",
    "runtime/.omx/**",
    "**/*.generated.ts",
    "**/*.js",
    "*.mjs",
    "**/*.test.ts",
    "**/src/test/**",
    "*.d.ts",
    "**/*.generated.d.ts",
    "packages/web/vite.config.ts",
    "packages/web/components.json",
    "packages/web/src/components/ui/**",
    "packages/web/src/lib/utils.ts"
  ],
  "rules": {
    "no-unused-vars": "off"
  },
  "plugins": ["eslint"],
  "categories": {
    "correctness": "error"
  }
}
